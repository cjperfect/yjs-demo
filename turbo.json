{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": [".env", "tsconfig.base.json", "pnpm-workspace.yaml"],
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "REDIS_URL",
    "SERVER_PORT",
    "SERVER_CORS_ORIGIN",
    "NEXT_PUBLIC_WS_URL",
    "NEXT_PUBLIC_API_URL",
    "MOCK_USER_ID",
    "MOCK_USER_NAME",
    "MOCK_USER_COLOR"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**/*", "package.json", "tsconfig.json", "tsup.config.ts"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "env": ["DATABASE_URL", "REDIS_URL", "SERVER_PORT"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "clean": {
      "cache": false
    }
  }
}
