{
  "name": "@yjs-demo/server",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "start:prod": "NODE_ENV=production node dist/main.js",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo",
    "prisma:generate": "dotenv -e ../../.env -- prisma generate",
    "prisma:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "prisma:studio": "dotenv -e ../../.env -- prisma studio",
    "prisma:push": "dotenv -e ../../.env -- prisma db push"
  },
  "dependencies": {
    "@yjs-demo/shared": "workspace:*",
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-express": "catalog:",
    "@nestjs/platform-ws": "catalog:",
    "@nestjs/websockets": "catalog:",
    "@prisma/client": "catalog:",
    "ioredis": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "ws": "catalog:",
    "yjs": "catalog:",
    "y-protocols": "catalog:",
    "lib0": "catalog:",
    "zod": "catalog:",
    "nanoid": "catalog:",
    "dotenv": "catalog:"
  },
  "devDependencies": {
    "@nestjs/cli": "catalog:",
    "typescript": "catalog:",
    "ts-node": "^10.9.2",
    "@types/node": "^22.10.0",
    "@types/ws": "catalog:",
    "prisma": "catalog:"
  }
}
