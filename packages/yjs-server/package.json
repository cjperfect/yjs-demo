{
  "name": "@yjs-demo/yjs-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.dts.json",
    "dev": "tsc -p tsconfig.dts.json && tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@yjs-demo/shared": "workspace:*",
    "yjs": "catalog:",
    "y-protocols": "catalog:",
    "lib0": "catalog:",
    "ws": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "tsup": "catalog:",
    "@types/ws": "catalog:",
    "@types/node": "^22.10.0"
  }
}
