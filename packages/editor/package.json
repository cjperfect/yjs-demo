{
  "name": "@yjs-demo/editor",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@yjs-demo/shared": "workspace:*",
    "yjs": "catalog:",
    "y-prosemirror": "catalog:",
    "y-websocket": "catalog:",
    "@tiptap/core": "catalog:",
    "@tiptap/react": "catalog:",
    "@tiptap/starter-kit": "catalog:",
    "@tiptap/extension-collaboration": "catalog:",
    "@tiptap/extension-collaboration-cursor": "catalog:",
    "@tiptap/suggestion": "catalog:",
    "@tiptap/pm": "catalog:",
    "prosemirror-state": "catalog:",
    "prosemirror-view": "catalog:",
    "prosemirror-model": "catalog:",
    "prosemirror-transform": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "tsup": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/node": "^22.10.0"
  }
}
